# Production Environment Configuration for Frontend

# API Base URL - Production Backend
VITE_API_BASE_URL=https://api.coop-match.online

# Asset Base URL - For static files, images, uploads
VITE_ASSET_BASE_URL=https://api.coop-match.online

# WebSocket URL for real-time features
VITE_WS_BASE_URL=wss://api.coop-match.online

# App Configuration
VITE_APP_TITLE=Co-op Match
VITE_APP_DESCRIPTION=ระบบจับคู่งานสหกิจศึกษา

# Production Settings
VITE_ENVIRONMENT=production
VITE_DEBUG=false

# Optional: Analytics, monitoring, etc.
# VITE_GA_TRACKING_ID=your-google-analytics-id
# VITE_SENTRY_DSN=your-sentry-dsn